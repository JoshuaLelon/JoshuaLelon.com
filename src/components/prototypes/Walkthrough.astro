---
import type { WalkthroughPageProps } from "./walkthrough";

interface Props extends WalkthroughPageProps {
  kind: "sentence-abstraction" | "one-choice-at-a-time";
  recordingSize?: [number, number];
  mobileSize?: [number, number];
  demo?: string;
  demoAlt?: string;
  embeddedExplanations?: boolean;
}
const {
  kind,
  slide,
  prototypePath,
  demo,
  demoAlt,
  embeddedExplanations = false,
  recordingSize = [690, 322],
  mobileSize = [322, 438],
} = Astro.props;
const showDemo = Boolean(demo) && slide === undefined;
const prefix = `prototype-${kind}`;
---

<prototype-walkthrough
  data-kind={kind}
  data-prototype-path={prototypePath}
  data-slide={slide}
  data-has-demo={Boolean(demo)}
  data-embedded-explanations={embeddedExplanations}
  class:list={["prototype-demo experiment-stage not-prose", `${kind}-demo`]}
>
  <div class="demo-inner">
    {
      demo && (
        <>
          <div
            class="prototype-tabs"
            role="tablist"
            aria-label="Prototype view"
          >
            <button
              role="tab"
              id={`${prefix}-demo-tab`}
              aria-controls={`${prefix}-demo-panel`}
              aria-selected={showDemo}
              tabindex={showDemo ? 0 : -1}
              data-view="demo"
            >
              demo
            </button>
            <button
              role="tab"
              id={`${prefix}-walk-tab`}
              aria-controls={`${prefix}-walk-panel`}
              aria-selected={!showDemo}
              tabindex={showDemo ? -1 : 0}
              data-view="walk"
            >
              walk through
            </button>
          </div>
          <div
            id={`${prefix}-demo-panel`}
            role="tabpanel"
            aria-labelledby={`${prefix}-demo-tab`}
            hidden={!showDemo}
            data-demo-panel
          >
            {["light", "dark"].map(theme => (
              <picture class={`demo-recording recording-${theme}`}>
                <source
                  media="(prefers-reduced-motion: reduce) and (max-width: 440px)"
                  srcset={`${demo}-${theme}-mobile.png`}
                  width={mobileSize[0]}
                  height={mobileSize[1]}
                />
                <source
                  media="(prefers-reduced-motion: reduce)"
                  srcset={`${demo}-${theme}.png`}
                />
                <source
                  media="(max-width: 440px)"
                  srcset={`${demo}-${theme}-mobile.gif`}
                  width={mobileSize[0]}
                  height={mobileSize[1]}
                />
                <img
                  src={`${demo}-${theme}.gif`}
                  alt={demoAlt}
                  loading="lazy"
                  decoding="async"
                  width={recordingSize[0]}
                  height={recordingSize[1]}
                />
              </picture>
            ))}
          </div>
        </>
      )
    }
    <div
      id={`${prefix}-walk-panel`}
      role={demo ? "tabpanel" : undefined}
      aria-labelledby={demo ? `${prefix}-walk-tab` : undefined}
      data-walk-panel
      hidden={showDemo}
    >
      <section
        class="walkthrough"
        aria-label="Demo walkthrough"
        hidden={embeddedExplanations}
      >
        <div class="walkthrough-caption" aria-live="polite" aria-atomic="true">
          <strong></strong><p></p>
        </div>
      </section>
      <div
        class="tour-stage"
        role="region"
        aria-label="Demonstration"
        tabindex="0"
        data-pagefind-ignore
      >
        <slot />
      </div>
      <div class="walkthrough-nav" role="group" aria-label="Walkthrough steps">
        <button data-back disabled>← Previous</button>
        <span class="walkthrough-count"></span>
        <button data-next disabled>Next →</button>
      </div>
    </div>
  </div>
</prototype-walkthrough>
<script>
  import { walkthrough } from "./walkthrough";
  import { sentenceAbstractionSteps } from "./sentenceAbstractionSteps";
  import { writingSteps } from "./writingSteps";
  class PrototypeWalkthrough extends HTMLElement {
    private controller?: ReturnType<typeof walkthrough>;
    private events?: AbortController;
    connectedCallback() {
      if (this.events) return;
      this.events = new AbortController();
      const tabs = [
        ...this.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      ];
      const walkPanel = this.querySelector<HTMLElement>("[data-walk-panel]")!;
      const demoPanel = this.querySelector<HTMLElement>("[data-demo-panel]");
      const select = (tab: HTMLButtonElement) => {
        tabs.forEach(item => {
          item.setAttribute("aria-selected", String(item === tab));
          item.tabIndex = item === tab ? 0 : -1;
        });
        walkPanel.hidden = tab.dataset.view !== "walk";
        if (demoPanel) demoPanel.hidden = !walkPanel.hidden;
        if (!walkPanel.hidden) {
          if (this.controller) this.controller.refresh();
          else this.initialize();
        }
        this.updateUrl(walkPanel.hidden ? undefined : this.controller?.slide);
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => select(tab), {
          signal: this.events!.signal,
        });
        tab.addEventListener(
          "keydown",
          event => {
            const destination =
              event.key === "Home"
                ? 0
                : event.key === "End"
                  ? tabs.length - 1
                  : event.key === "ArrowRight"
                    ? (index + 1) % tabs.length
                    : event.key === "ArrowLeft"
                      ? (index + tabs.length - 1) % tabs.length
                      : null;
            if (destination === null) return;
            event.preventDefault();
            select(tabs[destination]);
            tabs[destination].focus();
          },
          { signal: this.events!.signal }
        );
      });
      if (!walkPanel.hidden) {
        if (this.dataset.slide && !location.hash)
          this.scrollIntoView({ block: "start", behavior: "instant" });
        this.initialize();
      }
    }
    private updateUrl(slide?: number) {
      const path = this.dataset.prototypePath;
      if (!path) return; // Gallery embeds share a page.
      const url = new URL(location.href);
      url.pathname = slide ? path + slide + "/" : path;
      if (url.href !== location.href)
        history.replaceState(history.state, "", url);
    }
    private initialize() {
      if (this.controller) return;
      this.controller = walkthrough(
        this,
        this.dataset.kind === "one-choice-at-a-time"
          ? writingSteps(this)
          : sentenceAbstractionSteps(this),
        Number(this.dataset.slide ?? 1),
        slide => this.updateUrl(slide)
      );
    }
    disconnectedCallback() {
      this.controller?.destroy();
      this.controller = undefined;
      this.events?.abort();
      this.events = undefined;
    }
  }
  if (!customElements.get("prototype-walkthrough"))
    customElements.define("prototype-walkthrough", PrototypeWalkthrough);
</script>
<style>
  .prototype-demo {
    --canvas: #f5f6f3;
    --paper: #fff;
    --ink: #252a24;
    --secondary: #596254;
    --edge: rgb(0 0 0 / 0.14);
    --highlight: #e7eedb;
    --green: #355529;
    display: block;
    margin: 32px 0;
    border: 1px solid var(--edge);
    border-radius: 8px;
    background: var(--canvas);
    color: var(--ink);
    font:
      16px/1.6 system-ui,
      sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global([data-theme="dark"]) .prototype-demo {
    --canvas: #252b38;
    --paper: #303847;
    --ink: #eaeef4;
    --secondary: #b7c1cd;
    --edge: rgb(255 255 255 / 0.14);
    --highlight: #394832;
    --green: #c0d9a0;
  }
  .demo-inner {
    max-width: 740px;
    margin: auto;
    padding: 24px;
  }
  [hidden] {
    display: none !important;
  }
  .prototype-tabs {
    display: flex;
    gap: 24px;
    border-bottom: 1px solid var(--edge);
    margin-bottom: 24px;
  }
  .prototype-tabs button {
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 8px 0;
    color: var(--secondary);
    border-bottom: 2px solid transparent;
  }
  .prototype-tabs button[aria-selected="true"] {
    border-bottom-color: var(--green);
    color: var(--ink);
  }
  .demo-recording img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--edge);
    border-radius: 8px;
  }
  .recording-dark {
    display: none;
  }
  :global([data-theme="dark"]) .recording-light {
    display: none;
  }
  :global([data-theme="dark"]) .recording-dark {
    display: block;
  }
  button {
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid var(--edge);
    border-radius: 7px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    touch-action: manipulation;
  }
  button:focus-visible,
  .tour-stage:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }
  @media (hover: hover) and (pointer: fine) {
    button:not(:disabled):hover {
      border-color: var(--ink);
    }
  }
  .walkthrough {
    margin: 0 0 24px;
    border-bottom: 1px solid var(--edge);
    padding-bottom: 16px;
  }
  .walkthrough-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 24px;
    gap: 12px;
  }
  .walkthrough-count {
    font:
      13px ui-monospace,
      monospace;
    font-variant-numeric: tabular-nums;
    color: var(--secondary);
  }
  .walkthrough-nav button {
    font-size: 13px;
    padding-inline: 10px;
  }
  .walkthrough-nav button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .walkthrough-caption {
    min-height: 110px;
    padding-top: 16px;
    font-size: 14px;
  }
  .walkthrough-caption :global(strong) {
    font-size: 16px;
  }
  .walkthrough-caption :global(p) {
    margin: 5px 0 0;
    color: var(--secondary);
  }
  .sentence-abstraction-demo .walkthrough {
    margin-bottom: 16px;
  }
  .sentence-abstraction-demo .walkthrough-caption {
    min-height: 72px;
    padding-top: 0;
  }
  @media (max-width: 440px) {
    .prototype-demo .demo-inner {
      padding: 16px;
    }
    .sentence-abstraction-demo .walkthrough-caption {
      min-height: 96px;
    }
  }
  .prototype-demo :global([data-tour-cue="action"]) {
    outline: 3px solid var(--green);
    outline-offset: 4px;
    animation: tour-pulse 550ms ease-out;
  }
  .prototype-demo :global([data-tour-cue="result"]) {
    outline: 2px dashed var(--green);
    outline-offset: 4px;
  }
  @keyframes tour-pulse {
    from {
      outline-offset: 12px;
    }
    to {
      outline-offset: 4px;
    }
  }
  @media (max-width: 440px) {
    .walkthrough-caption {
      min-height: 120px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .prototype-demo :global([data-tour-cue]) {
      animation: none;
    }
  }

  .disclosure-demo .tour-stage {
    height: 480px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    padding: 8px;
    border: 1px solid var(--edge);
    border-radius: 12px;
  }
  .disclosure-demo .tour-stage :global(.article) {
    margin-top: 0;
  }

  .tour-stage :global(button),
  .tour-stage :global(input) {
    cursor: default;
  }
</style>
