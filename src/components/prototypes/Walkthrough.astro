---
interface Props {
  kind: "motion" | "disclosure";
}
const { kind } = Astro.props;
---

<prototype-walkthrough
  data-kind={kind}
  class:list={["prototype-demo experiment-stage not-prose", `${kind}-demo`]}
>
  <div class="demo-inner">
    <section class="walkthrough" aria-label="Demo walkthrough">
      <div class="walkthrough-nav" role="group" aria-label="Walkthrough steps">
        <button data-back disabled>← Previous</button>
        <span class="walkthrough-count"></span>
        <button data-next disabled>Next →</button>
      </div>
      <div class="walkthrough-caption" aria-live="polite" aria-atomic="true">
        <strong></strong><p></p>
      </div>
    </section>
    <div
      class="tour-stage"
      role="region"
      aria-label="Demonstration"
      tabindex="0"
      data-pagefind-ignore
    >
      <slot />
    </div>
  </div>
</prototype-walkthrough>
<script>
  import { walkthrough } from "./walkthrough";
  import { motionSteps } from "./motionSteps";
  import { disclosureSteps } from "./disclosureSteps";
  class PrototypeWalkthrough extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      if (this.cleanup) return;
      this.cleanup = walkthrough(
        this,
        this.dataset.kind === "motion"
          ? motionSteps(this)
          : disclosureSteps(this)
      );
    }
    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = undefined;
    }
  }
  if (!customElements.get("prototype-walkthrough"))
    customElements.define("prototype-walkthrough", PrototypeWalkthrough);
</script>
<style>
  .prototype-demo {
    --canvas: #f5f6f3;
    --paper: #fff;
    --ink: #252a24;
    --secondary: #596254;
    --edge: rgb(0 0 0 / 0.14);
    --highlight: #e7eedb;
    --green: #355529;
    display: block;
    margin: 32px 0;
    border: 1px solid var(--edge);
    border-radius: 8px;
    background: var(--canvas);
    color: var(--ink);
    font:
      16px/1.6 system-ui,
      sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global([data-theme="dark"]) .prototype-demo {
    --canvas: #252b38;
    --paper: #303847;
    --ink: #eaeef4;
    --secondary: #b7c1cd;
    --edge: rgb(255 255 255 / 0.14);
    --highlight: #394832;
    --green: #c0d9a0;
  }
  .demo-inner {
    max-width: 740px;
    margin: auto;
    padding: 24px;
  }
  button {
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid var(--edge);
    border-radius: 7px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    touch-action: manipulation;
  }
  button:focus-visible,
  .tour-stage:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }
  @media (hover: hover) and (pointer: fine) {
    button:not(:disabled):hover {
      border-color: var(--ink);
    }
  }
  .walkthrough {
    margin: 0 0 24px;
    border-bottom: 1px solid var(--edge);
    padding-bottom: 16px;
  }
  .walkthrough-nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .walkthrough-count {
    font:
      13px ui-monospace,
      monospace;
    font-variant-numeric: tabular-nums;
    color: var(--secondary);
  }
  .walkthrough-nav button {
    font-size: 13px;
    padding-inline: 10px;
  }
  .walkthrough button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .walkthrough-caption {
    min-height: 110px;
    padding-top: 16px;
    font-size: 14px;
  }
  .walkthrough-caption :global(strong) {
    font-size: 16px;
  }
  .walkthrough-caption :global(p) {
    margin: 5px 0 0;
    color: var(--secondary);
  }
  .prototype-demo :global([data-tour-cue="action"]) {
    outline: 3px solid var(--green);
    outline-offset: 4px;
    animation: tour-pulse 550ms ease-out;
  }
  .prototype-demo :global([data-tour-cue="result"]) {
    outline: 2px dashed var(--green);
    outline-offset: 4px;
  }
  @keyframes tour-pulse {
    from {
      outline-offset: 12px;
    }
    to {
      outline-offset: 4px;
    }
  }
  @media (max-width: 440px) {
    .walkthrough-nav {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .walkthrough-caption {
      min-height: 120px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .prototype-demo :global([data-tour-cue]) {
      animation: none;
    }
  }

  .disclosure-demo .tour-stage {
    height: 480px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    padding: 8px;
    border: 1px solid var(--edge);
    border-radius: 12px;
  }
  .disclosure-demo .tour-stage :global(.article) {
    margin-top: 0;
  }

  .tour-stage :global(button),
  .tour-stage :global(input) {
    cursor: default;
  }
</style>
