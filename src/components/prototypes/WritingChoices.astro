---
import Walkthrough from "./Walkthrough.astro";
import WritingMic from "./WritingMic.astro";
import { writingFeatureIndex } from "./writingSteps";
import type { WalkthroughPageProps } from "./walkthrough";
type Props = WalkthroughPageProps;
---

<Walkthrough
  {...Astro.props}
  kind="one-choice-at-a-time"
  demo="/assets/prototypes/one-choice-at-a-time"
  demoAlt="a blank page becomes a short mystery as a writer chooses a genre, records a character, expands an outline, and tries another version of the opening."
  embeddedExplanations
  features={writingFeatureIndex}
  recordingSize={[690, 474]}
  mobileSize={[322, 572]}
>
  <section class="writing-scene">
    <template data-dictation><WritingMic scope="question" /></template>
    <div class="writing-workbench" aria-label="writing canvas">
      <div class="writing-pointer" aria-hidden="true" hidden>
        <svg width="23" height="29" viewBox="0 0 23 29" focusable="false">
          <path
            d="M2 2 20 16.3l-8 .9 4 8.2-4 1.8-3.8-8.5-5.4 5.4z"
            fill="var(--ink)"
            stroke="var(--paper)"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
        </svg>
        <span class="scroll-direction"></span>
      </div>
      <div class="selection-margin" aria-hidden="true"></div>
      <div class="draft-page" aria-label="document"></div>
      <div class="selection-dictation">
        <WritingMic scope="selection" />
      </div>
      <div class="decision-dock" aria-label="writing choices"></div>
    </div>
    <div
      class="writing-help-card"
      popover="auto"
      role="dialog"
      aria-label="writing reference"
    >
      <strong></strong><button type="button" aria-label="close help">×</button>
      <p></p><figure><figcaption>example</figcaption><div></div></figure><footer
      >
      </footer>
    </div>
    <div class="writing-narration" aria-live="polite"><p></p></div>
  </section>
</Walkthrough>
<style is:global>
  .writing-scene {
    --selection-rail: 24px;
    --marker-width: 18px;
    --version-space: 34px;
    --tree-indent: clamp(1.25rem, 4cqi, 1.5rem);
    container-type: inline-size;
    border: 1px solid var(--edge);
    border-radius: 8px;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
  }
  .writing-workbench {
    position: relative;
    isolation: isolate;
    min-height: calc(
      var(--workbench-height, 474px) + var(--dictation-space, 0px)
    );
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto auto;
    font:
      14px/1.45 system-ui,
      sans-serif;
  }
  .writing-workbench [data-chosen="true"] {
    background: color-mix(
      in srgb,
      var(--highlight) var(--press-fill),
      var(--press-base, transparent)
    );
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, var(--green) var(--press-fill), transparent);
    color: color-mix(in srgb, var(--green) var(--press-fill), currentColor);
  }
  .writing-pointer {
    position: absolute;
    inset: 0 auto auto 0;
    z-index: 3;
    line-height: 0;
    pointer-events: none;
    filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.26));
  }
  .writing-pointer svg {
    transform: translate(-2px, -2px);
    transform-origin: 2px 2px;
  }
  .scroll-direction {
    display: none;
    position: absolute;
    left: 18px;
    top: 4px;
    width: 22px;
    height: 22px;
    place-items: center;
    border: 1px solid var(--green);
    border-radius: 50%;
    background: var(--paper);
    color: var(--green);
    font:
      600 15px/1 system-ui,
      sans-serif;
  }
  .writing-pointer[data-scroll] .scroll-direction {
    display: grid;
  }
  .selection-margin {
    position: absolute;
    z-index: 1;
    inset: 0 auto 0 0;
    width: var(--selection-rail);
    grid-area: 1 / 1 / 3 / 2;
    background: var(--canvas);
    border-inline-end: 1px solid var(--edge);
    opacity: 0;
    pointer-events: none;
  }
  .writing-workbench:has(.beat-list) .selection-margin {
    opacity: 1;
  }
  /* Each branch keeps its disclosure in the parent's gutter. */
  .draft-page:has(.draft-tree) {
    padding-inline-start: calc(
      var(--selection-rail) + var(--marker-width) + 2px
    );
  }
  .draft-page [data-contains-selection] .draft-words {
    text-decoration: underline dashed var(--green);
    text-underline-offset: 4px;
  }
  .draft-page [data-drafting] {
    position: relative;
  }
  .writing-loader {
    opacity: 0;
    position: absolute;
    display: grid;
    align-content: center;
    justify-items: start;
    width: 26px;
    height: 17px;
    gap: 3px;
    pointer-events: none;
  }
  .writing-loader i {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 1px;
    background: var(--green);
    transform-origin: left;
  }
  .writing-loader i:nth-child(2) {
    width: 25px;
  }
  .writing-loader i:nth-child(3) {
    width: 14px;
  }
  .writing-workbench[inert] {
    visibility: hidden;
  }
  .writing-scene button {
    min-height: 38px;
    padding: 6px 10px;
    border: 1px solid transparent;
    background: transparent;
    border-radius: 5px;
    font: inherit;
    color: inherit;
    cursor: default;
    opacity: 1;
    -webkit-text-fill-color: currentColor;
  }
  .writing-scene button:focus-visible,
  .writing-scene [tabindex]:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: -2px;
  }
  .decision-head,
  .choice-list {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .decision-head button {
    font-size: 12px;
    color: var(--secondary);
  }
  .draft-page {
    position: relative;
    --selection-fill: #d4e6c2;
    align-content: start;
    padding: 24px 32px;
  }
  .draft-page .premise-text,
  .draft-page .beat-text {
    margin: 0;
    font:
      18px/1.48 Georgia,
      serif;
  }
  [data-theme="dark"] .draft-page {
    --selection-fill: #486143;
  }
  .draft-page .draft-words {
    opacity: var(--prose-opacity, 1);
  }
  .draft-page :is(.sentence-label, .term-label, .draft-disclosure),
  .draft-page .term-annotation::before {
    opacity: var(--annotation-opacity, 1);
  }
  .draft-page[data-selected] .draft-words,
  .draft-page [data-selected] .draft-words {
    border-radius: 2px;
    --selected-ink: color-mix(
      in srgb,
      var(--selection-fill) var(--selection-amount, 100%),
      transparent
    );
    background: color-mix(
      in srgb,
      var(--selected-ink) var(--revision-fill, 100%),
      transparent
    );
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .draft-page .blank-sheet {
    display: block;
    width: 1ch;
    height: 28px;
    border-inline-start: 2px solid var(--green);
  }
  .draft-page[data-selected] .blank-sheet {
    background: color-mix(
      in srgb,
      var(--selection-fill) var(--selection-amount, 100%),
      transparent
    );
  }
  .draft-tree {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    --bracket-ink: var(--secondary);
  }
  .draft-tree > :is(.premise-row, .genre-menu) {
    grid-area: 1 / 1;
  }
  .sentence-annotation {
    display: inline-grid;
    grid-template-columns: minmax(0, auto) auto;
    align-items: center;
    column-gap: 6px;
    width: fit-content;
    max-width: 100%;
  }
  .sentence-label,
  .writing-scene .sentence-label button,
  .writing-scene .term-label {
    color: var(--secondary);
    font:
      11px/1.4 ui-monospace,
      monospace;
  }
  .sentence-label {
    display: flex;
    position: relative;
    align-items: center;
    align-self: stretch;
    padding-inline-start: 11px;
  }
  .sentence-label::before {
    content: "";
    position: absolute;
    inset-block: 2px;
    inset-inline-start: 0;
    width: 5px;
    border: 1px solid var(--bracket-ink);
    border-inline-start: 0;
  }
  .writing-scene .sentence-label button,
  .writing-scene .term-label {
    min-height: 0;
    padding: 0;
    border: 0;
    border-radius: 2px;
  }
  .document-type,
  .act-menu-anchor {
    position: relative;
  }
  .document-type {
    min-inline-size: calc(var(--genre-chars) * 1ch + 1em);
  }
  .writing-scene .taxonomy-trigger {
    white-space: nowrap;
    cursor: pointer;
  }
  .revision-label {
    display: inline-grid;
    vertical-align: baseline;
  }
  .revision-label > span {
    grid-area: 1 / 1;
    justify-self: start;
    text-align: left;
    white-space: pre;
  }
  .document-labels::before {
    scale: 1 var(--bracket-scale, 1);
  }
  :is(.document-labels, .beat-label)::before {
    transform: var(--scope-line-transform, none);
    transform-origin: left center;
  }
  .revision-word {
    display: inline-block;
  }
  .revision-overlay {
    position: absolute;
    inset: 0 0 auto;
    padding: inherit;
    visibility: hidden;
    pointer-events: none;
  }
  .revision-overlay [data-revision-source] .draft-words {
    visibility: visible;
  }
  .taxonomy-trigger::after {
    content: "";
    display: inline-block;
    vertical-align: 0.18em;
    translate: var(--caret-offset, 0px) 0;
    margin-inline-start: 0.45em;
    width: 5px;
    height: 5px;
    border: solid currentColor;
    border-width: 0 1px 1px 0;
    transform: rotate(45deg);
  }
  .taxonomy-trigger[aria-expanded="true"]::after {
    transform: rotate(225deg);
  }
  .genre-menu {
    z-index: 2;
    justify-self: start;
    display: grid;
    width: max-content;
    min-width: 132px;
    padding: 4px;
    border-radius: 6px;
    border: 1px solid var(--edge);
    background: var(--paper);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.14);
  }
  .writing-scene .genre-menu [role="menuitemradio"] {
    text-align: left;
    min-height: 0;
    padding: 3px 8px;
    color: var(--ink);
    font:
      12px/1.45 system-ui,
      sans-serif;
  }
  .genre-menu [aria-checked="true"]::after {
    content: "✓";
    float: right;
    color: var(--green);
    margin-inline-start: 12px;
  }
  .term-annotation {
    display: inline-block;
    position: relative;
    max-width: 100%;
    padding-block-start: calc(20px * var(--term-space, 1));
  }
  .term-annotation::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 16px;
    height: 4px;
    border: 1px solid var(--bracket-ink);
    border-block-end: 0;
  }
  .term-annotation::before,
  .term-annotation > .term-label {
    translate: var(--term-x, 0px) var(--term-y, 0px);
  }
  .writing-scene .term-label {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .premise-row,
  .beat-branch {
    width: fit-content;
    max-width: 100%;
  }
  .story-body,
  .act-body {
    position: relative;
    min-width: 0;
  }
  /* Anchor to the first text baseline, including when a term has a label above it. */
  .branch-marker {
    position: relative;
    display: inline-block;
    width: 0;
    height: 0;
    vertical-align: baseline;
  }
  .writing-scene .draft-disclosure {
    appearance: none;
    position: absolute;
    inset-inline-end: 0;
    bottom: calc(0.68ex - 7px);
    width: var(--marker-width);
    height: 14px;
    overflow: hidden;
    min-height: 0;
    padding: 0;
    border: 0;
    color: var(--green);
    font: inherit;
  }
  :is(.story-body, .act-body):has(> .branch-marker),
  .prose-leaf:has(> .leaf-detail) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: first baseline;
  }
  :is(.story-body, .act-body, .prose-leaf:has(> .leaf-detail))
    > :is(.branch-marker, .beat-list, .scene-prose, .leaf-detail) {
    grid-area: 1 / 1;
  }
  :is(.story-body, .act-body, .prose-leaf:has(> .leaf-detail))
    > .branch-marker {
    justify-self: start;
  }
  /* Grow the gutter at this node only. The icon keeps its column and the
     counter has its own trailing space before either prose or a child marker. */
  :is(.story-body, .act-body, .premise-text, .beat-text, .prose-leaf):has(
    > .branch-marker > .draft-disclosure > .version-count
  ) {
    padding-inline-start: var(--version-space);
  }
  .writing-scene .draft-disclosure:has(> .version-count) {
    width: calc(var(--marker-width) + var(--version-space));
    height: 18px;
    bottom: calc(0.68ex - 9px);
    display: flex;
    align-items: center;
    padding-inline-start: var(--marker-width);
  }
  .writing-scene .draft-disclosure:has(> .version-count)::before {
    left: calc(var(--marker-width) / 2);
  }
  .version-count {
    padding: 1px 3px;
    border-radius: 3px;
    color: var(--secondary);
    background: color-mix(in srgb, currentColor 9%, transparent);
    font:
      10px/1.3 ui-monospace,
      monospace;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .draft-disclosure.generate-branch::before {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    width: 11px;
    height: 11px;
    background: currentColor;
    clip-path: polygon(
      50% 0%,
      65% 35%,
      100% 50%,
      65% 65%,
      50% 100%,
      35% 65%,
      0% 50%,
      35% 35%
    );
  }
  .draft-disclosure[aria-expanded]::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 7px;
    height: 7px;
    border: solid currentColor;
    border-width: 1.5px 1.5px 0 0;
    transform: translate(-65%, -50%) rotate(45deg);
  }
  .draft-disclosure[aria-expanded="true"]::before {
    transform: translate(-50%, -65%) rotate(135deg);
  }
  .beat-list {
    display: grid;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Every act inherits the same text and annotation columns from the outline. */
  .beat-list {
    grid-template-columns: minmax(0, 1fr) max-content;
    column-gap: 6px;
  }
  .beat-list > .beat,
  .beat-list > .beat > .beat-branch,
  .beat-list > .beat > .beat-branch > .sentence-annotation {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    width: auto;
    min-width: 0;
  }
  .beat-list .beat {
    margin: 0;
    padding: 3px 0;
  }
  .beat-list,
  .act-body > .scene-prose,
  .leaf-detail {
    margin-inline-start: var(--tree-indent);
  }
  .beat-branch .draft-disclosure,
  .beat-list .beat-text {
    font-size: 16px;
    line-height: 1.42;
  }
  .selection-dictation {
    grid-area: 2 / 1;
    padding: 0 12px 6px;
  }
  .writing-workbench:not(:has(.draft-tree)) .selection-dictation {
    display: none;
  }
  .selection-dictation .dictation-row {
    margin: 0;
    padding-bottom: var(--dictation-space, 0px);
  }
  .selection-dictation .dictated-words {
    min-height: 32px;
  }
  .decision-dock {
    grid-area: 3 / 1;
    --arrow-gap: clamp(16px, 3cqi, 22px);
    --preview-height: 44px;
    --heading-height: 62px;
    --actions-height: 30px;
    display: grid;
    isolation: isolate;
    grid-template-columns:
      minmax(0, 1fr) minmax(0, clamp(148px, 40cqi, 290px))
      minmax(0, 1fr);
    /* Keep both preview tracks even when a question has no neighbor. */
    grid-template-rows:
      var(--actions-height) var(--preview-height) var(--arrow-gap)
      minmax(var(--heading-height), auto) auto auto
      var(--arrow-gap) var(--preview-height);
    column-gap: var(--arrow-gap);
    padding: 6px 24px 9px;
    background: var(--canvas);
    border-top: 1px solid var(--edge);
  }
  .dictation-row {
    position: relative;
    display: grid;
    justify-items: center;
    margin-top: 4px;
  }
  .writing-scene .dictation-mic {
    display: grid;
    place-items: center;
    transform: translateY(var(--dictation-space, 0px));
    min-height: 32px;
    width: 34px;
    padding: 0;
    border-radius: 50%;
    color: var(--secondary);
  }
  .dictation-mic[aria-pressed="true"] {
    background: var(--highlight);
    color: var(--green);
  }
  .dictated-words {
    position: absolute;
    inset: 0 0 auto;
    min-height: 100%;
    display: grid;
    align-content: center;
    margin: 0;
    visibility: hidden;
    opacity: var(--dictation-opacity, 0);
    text-align: center;
    font:
      16px/1.5 system-ui,
      sans-serif;
  }
  .writing-scene:not([data-dictating="selection"]) [data-voice="selection"],
  .writing-scene:not([data-dictating="question"]) [data-voice="question"] {
    --dictation-space: 0px;
    --dictation-opacity: 0;
  }
  .writing-scene[data-dictating="selection"]
    [data-voice="selection"]
    .dictated-words,
  .writing-scene[data-dictating="question"]
    [data-voice="question"]
    .dictated-words {
    visibility: visible;
  }
  .decision-dock:empty {
    display: none;
  }
  .decision-head {
    flex-wrap: wrap;
    min-height: 30px;
  }
  .decision-head > div {
    margin-inline-start: auto;
  }
  .decision-head button {
    min-height: 30px;
    padding: 0 4px;
  }
  .decision-head .panel-label {
    font:
      11px/1.4 ui-monospace,
      monospace;
    color: var(--secondary);
  }
  .decision-dock::before {
    content: "";
    grid-area: 4 / 2 / 7 / 3;
    z-index: -1;
    border: 1px solid var(--edge);
    border-radius: 9px;
    background: var(--paper);
  }
  .decision-head {
    grid-area: 1 / 1 / 2 / -1;
  }
  .decision-dock > .question-line {
    grid-area: 4 / 2;
    align-self: center;
    min-width: 0;
    max-width: calc(100% - 46px);
    position: relative;
    margin: 10px auto 7px;
  }
  .question-line > .writing-help {
    position: absolute;
    inset: 0 auto auto 100%;
  }
  .decision-dock > .choice-window {
    grid-area: 5 / 2;
    width: min(calc(100% - 16px), 33.333cqi);
    --rail-edge: var(--paper);
  }
  .decision-dock > .dictation-row {
    grid-area: 6 / 2;
    padding-bottom: 4px;
    margin-bottom: var(--dictation-space, 0px);
  }
  .question-preview {
    --preview-opacity: 0.14;
    position: relative;
    width: fit-content;
    max-width: 100%;
    align-self: center;
    color: var(--secondary);
    font:
      12px/1.3 system-ui,
      sans-serif;
    text-align: center;
    text-wrap: balance;
  }
  .decision-dock > [data-question-moving] {
    z-index: 2;
    pointer-events: none;
  }
  [data-theme="dark"] .question-preview {
    --preview-opacity: 0.115;
  }
  /* The parent fades between questions. Keep the resting opacity on its children. */
  .question-preview > :is(.preview-copy, .preview-arrow) {
    opacity: var(--preview-opacity);
  }
  @media (prefers-contrast: more), (forced-colors: active) {
    .question-preview > :is(.preview-copy, .preview-arrow) {
      opacity: 1;
    }
  }
  .preview-copy {
    display: block;
    padding: 5px 8px;
    border: 1px solid var(--edge);
    border-radius: 7px;
    background: color-mix(in srgb, var(--paper) 55%, var(--canvas));
  }
  /* Each chevron sits halfway across the gutter, pointing away from the center. */
  .preview-arrow {
    position: absolute;
    top: var(--arrow-y, 50%);
    left: var(--arrow-x, 50%);
    width: 6px;
    height: 6px;
    translate: -50% -50%;
    rotate: var(--arrow-angle);
    border: solid currentColor;
    border-width: 1.5px 1.5px 0 0;
    pointer-events: none;
  }
  .preview-left,
  .preview-right {
    width: min(100%, 154px);
  }
  .preview-left {
    grid-area: 4 / 1 / 7 / 2;
    justify-self: end;
    --arrow-x: calc(100% + var(--arrow-gap) / 2);
    --arrow-angle: -135deg;
  }
  .preview-right {
    grid-area: 4 / 3 / 7 / 4;
    justify-self: start;
    --arrow-x: calc(0px - var(--arrow-gap) / 2);
    --arrow-angle: 45deg;
  }
  .preview-up,
  .preview-down {
    justify-self: center;
  }
  .preview-up {
    grid-area: 2 / 2;
    align-self: end;
    --arrow-y: calc(100% + var(--arrow-gap) / 2);
    --arrow-angle: -45deg;
  }
  .preview-down {
    grid-area: 8 / 2;
    align-self: start;
    --arrow-y: calc(0px - var(--arrow-gap) / 2);
    --arrow-angle: 135deg;
  }
  .question-line {
    display: flex;
    width: fit-content;
    max-width: 100%;
    align-items: flex-start;
    margin: 4px auto 10px;
  }
  .decision-dock h4 {
    display: grid;
    margin: 0;
    text-align: center;
    font:
      600 17px/1.3 system-ui,
      sans-serif;
  }
  .decision-dock h4 > span {
    grid-area: 1 / 1;
  }
  .choice-window {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: clamp(12rem, 33.333cqi, 100%);
    max-width: 100%;
    margin-inline: auto;
  }
  .choice-window::before,
  .choice-window::after {
    grid-area: 1 / 1;
    content: "";
    position: absolute;
    z-index: 1;
    inset-block: 3px 6px;
    pointer-events: none;
  }
  .choice-window::before {
    left: 0;
    width: var(--fade-left, 0px);
    background: linear-gradient(
      to right,
      var(--rail-edge, var(--canvas)),
      transparent
    );
  }
