---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  variant?: "default" | "plain";
};
const { tag, tagName, size = "lg", variant = "default" } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    class:list={[
      "inline-flex min-h-11 items-center gap-0.5 underline decoration-dashed underline-offset-4 hover:text-accent focus-visible:text-accent",
      {
        "text-sm": size === "sm",
        "text-lg": size === "lg",
        "text-muted-foreground": variant === "plain",
      },
    ]}
  >
    {
      variant === "default" && (
        <IconHash
          aria-hidden="true"
          class:list={[
            "opacity-80",
            { "size-5": size === "lg", "size-4": size === "sm" },
          ]}
        />
      )
    }
    {tagName}
  </a>
</li>
