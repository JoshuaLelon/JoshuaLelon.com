---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const friends = await getEntry("pages", "friends");

if (!friends) {
  throw new Error(
    "Missing content entry: `friends.md` or `friends.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(friends);
---

<Layout
  title={`${friends.data.title} | ${config.site.title}`}
  description={friends.data.description}
  ogImage={friends.data.ogImage}
  canonicalURL={friends.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={friends.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
