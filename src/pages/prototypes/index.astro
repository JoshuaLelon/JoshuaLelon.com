---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import Tag from "@/components/Tag.astro";
import PrototypeDemo from "@/components/prototypes/PrototypeDemo.astro";
import { slugifyStr } from "@/utils/slugify";

const experiments = (
  await getCollection("prototypes", ({ data }) => !data.draft)
).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)
);
const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`Prototypes | ${config.site.title}`}
  description="Step-by-step demonstrations of interface experiments."
>
  <Header />
  <main
    id="main-content"
    class="mx-auto w-full max-w-5xl px-4 pt-10 pb-16 sm:pt-12"
  >
    <header class="mb-12 max-w-2xl">
      <h1 class="text-3xl leading-tight font-semibold text-balance sm:text-4xl">
        Prototypes
      </h1>
      <p
        class="mt-4 max-w-prose text-base leading-relaxed text-pretty text-muted-foreground"
      >
        Step-by-step demonstrations of interface experiments.
      </p>
    </header>
    {
      experiments.length ? (
        <ul class="space-y-12">
          {experiments.map(({ id, data }) => (
            <li>
              <h2 class="max-w-3xl text-3xl leading-tight font-semibold text-balance sm:text-4xl">
                <a
                  class="hover:text-accent"
                  href={getRelativeLocaleUrl(locale, `prototypes/${id}`)}
                >
                  {data.title}
                </a>
              </h2>
              {data.tags.length > 0 && (
                <ul
                  aria-label="topics"
                  class="mt-4 flex flex-wrap gap-x-4 gap-y-2"
                >
                  {data.tags.map(tag => (
                    <Tag
                      tag={slugifyStr(tag)}
                      tagName={tag}
                      size="sm"
                      variant="plain"
                    />
                  ))}
                </ul>
              )}
              <PrototypeDemo kind={data.demo} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="border-y border-border py-12">
          <h2 class="text-xl font-medium">Nothing published yet.</h2>
          <p class="mt-3 max-w-xl text-muted-foreground">
            This is where I’ll share interactive experiments and the thinking
            behind them.
          </p>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>
